# =============================================================================
# FrameVault Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ── Backend: Application ──────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Secret key for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend API host/port (used by Uvicorn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Backend: Database ─────────────────────────────────────────────────────────
# Full PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg2://framevault:framevault@localhost:5432/framevault

# ── Backend: AWS / S3 ─────────────────────────────────────────────────────────
# Storage adapter: "s3" | "local"
# Use "local" for development without AWS credentials.
# Use "s3" for production with a real S3 bucket.
STORAGE_BACKEND=local

# AWS region (required when STORAGE_BACKEND=s3)
AWS_REGION=us-east-1

# S3 bucket name (required when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=your-framevault-bucket

# AWS credentials — prefer IAM roles on EC2 (leave blank when using IAM role)
# NEVER commit real credentials to source control.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Presigned URL expiry (seconds)
# Upload URLs: shorter expiry for security
PRESIGNED_UPLOAD_EXPIRES=900
# Download URLs: longer expiry is acceptable
PRESIGNED_DOWNLOAD_EXPIRES=3600

# ── Frontend: API ─────────────────────────────────────────────────────────────
# Base URL of the backend API — used by Vite during build
# In development this is proxied by Vite; in production Nginx proxies /api
VITE_API_BASE_URL=http://localhost:8000

# ── Docker Compose ────────────────────────────────────────────────────────────
# PostgreSQL credentials (used by the postgres service in docker-compose.yml)
POSTGRES_DB=framevault
POSTGRES_USER=framevault
POSTGRES_PASSWORD=framevault

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Local Storage Adapter ─────────────────────────────────────────────────────
# Directory used by the local filesystem storage adapter (dev only)
LOCAL_STORAGE_PATH=./local_storage

# =============================================================================
# FrameVault — .gitignore
# =============================================================================

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Python / Backend ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# ── Docker ────────────────────────────────────────────────────────────────────
# Docker override files (local overrides only)
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
postgres_data/
pgdata/

# ── AWS / Cloud ───────────────────────────────────────────────────────────────
.aws/credentials
*.pem
*.key

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Local Dev Storage ─────────────────────────────────────────────────────────
# Local filesystem storage adapter (dev only — not for production)
backend/local_storage/
backend/.local_uploads/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*~
.temp/
tmp/
